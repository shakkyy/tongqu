# ========== OpenAI 兼容文本模型（可选，优先用于叙事 / Agent Function Calling）==========
OPENAI_BASE_URL=https://svip.xty.app/v1
OPENAI_API_KEY=sk-your-openai-compatible-key
OPENAI_MODEL=gpt-5.4-mini
OPENAI_TIMEOUT_SECONDS=100
OPENAI_MAX_RETRIES=0

# ========== DashScope（草图 VL / 语音 ASR / TTS；未配置 OPENAI_* 时也用于叙事）==========
DASHSCOPE_API_KEY=sk-your-dashscope-key
DASHSCOPE_COMPAT_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
DASHSCOPE_VL_BASE_HTTP_API_URL=https://dashscope.aliyuncs.com/api/v1
QWEN_MODEL=qwen3.6-plus
QWEN_VL_MODEL=qwen3-vl-plus
QWEN_ASR_MODEL=qwen3-asr-flash
DASHSCOPE_TTS_MODEL=cosyvoice-v3-flash
DASHSCOPE_TTS_VOICE=longanyang
DASHSCOPE_TTS_FORMAT=mp3
DASHSCOPE_TTS_SAMPLE_RATE=24000
# 语音合成并发数。演示速度优先设为 5；若触发 DashScope TTS 限流可降为 2。
TTS_SYNTHESIS_CONCURRENCY=5

# ========== 绘本配图（二选一）==========
# 方式 A：OpenAI 兼容中转（需中转站支持文生图模型名）
GEMINI_OPENAI_API_KEY=sk-your-proxy-key
GEMINI_OPENAI_BASE_URL=https://your-proxy.example/v1
GEMINI_IMAGE_MODEL=gemini-2.0-flash-preview-image-generation
GEMINI_IMAGE_ASPECT_RATIO=16:9
GEMINI_IMAGE_SIZE=1K
# 插图并发数。演示速度优先设为 5；如果遇到限流可降为 2 或 3。
IMAGE_GENERATION_CONCURRENCY=5

# 方式 B：直连 Google（不填 GEMINI_OPENAI_BASE_URL 时走 google-genai）
# GOOGLE_API_KEY=your-google-api-key

# ========== 可选：风格关键词增强 ==========
# 用户先选大风格，Ranker 只在该风格词库内为每页 image_prompt 选 Top-K 视觉强化词。
STYLE_KEYWORD_ENHANCER_ENABLED=0
STYLE_KEYWORD_TOP_K=4
STYLE_KEYWORD_BASE_MODEL=BAAI/bge-small-zh-v1.5
STYLE_KEYWORD_BANK_PATH=data/style_keywords.json
STYLE_KEYWORD_MODEL_DIR=training/artifacts/style_keyword_ranker

# ========== 生成产物审计 ==========
# 每次绘本生成按时间戳保存请求、完整 prompt 链路、模型响应和输出资源。
RUN_ARTIFACTS_ENABLED=1
RUN_ARTIFACT_DIR=../out/runs

# ========== 本地内容安全模型 ==========
# 已下载时默认走 Qwen/Qwen3Guard-Gen-0.6B；缺失或失败会退回本地关键词规则。
CONTENT_SAFETY_GUARD_ENABLED=1
CONTENT_SAFETY_GUARD_MODEL_PATH=models/Qwen3Guard-Gen-0.6B
CONTENT_SAFETY_GUARD_DEVICE=cpu
CONTENT_SAFETY_GUARD_MAX_INPUT_TOKENS=4096
CONTENT_SAFETY_GUARD_MAX_NEW_TOKENS=128

# ========== 文化 RAG ==========
CULTURE_RAG_CORPUS_PATH=../chinese-stories-database
CULTURE_RAG_TOP_K=3
CULTURE_RAG_MIN_SCORE=0.18
CULTURE_RAG_EMBEDDING_ENABLED=0
CULTURE_RAG_EMBEDDING_MODEL=BAAI/bge-large-zh-v1.5
# 默认只从本机缓存加载，避免演示时自动联网下载；首次使用前可手动下载模型或设为 0 允许下载。
CULTURE_RAG_EMBEDDING_LOCAL_ONLY=1
CULTURE_RAG_KEYWORD_WEIGHT=0.35
CULTURE_RAG_EMBEDDING_WEIGHT=0.65
CULTURE_RAG_MAX_RETURN=2
CULTURE_RAG_RELATIVE_SCORE_DROP=0.22
